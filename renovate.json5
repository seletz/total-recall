// Renovate configuration. Run by .github/workflows/renovate.yml every 8 hours.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Default rules; the Go modules, GitHub Actions and mise managers are
  // enabled by it and stay enabled.
  extends: ["config:recommended"],

  // Development happens on develop; PRs go there, not to the default branch.
  // (Renovate 44 renamed baseBranches to baseBranchPatterns.)
  baseBranchPatterns: ["develop"],

  labels: ["dependencies"],

  // Semantic commits in the repo style: "chore(deps): update module x to v1.2".
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",

  // Run `go mod tidy` after every Go update so go.mod/go.sum stay consistent.
  postUpdateOptions: ["gomodTidy"],

  // No "schedule": the workflow itself runs every 8 hours, and security
  // updates must never wait for a time window.

  // Throttle regular PRs.
  prHourlyLimit: 2,
  prConcurrentLimit: 5,

  // Security fixes: open PRs for GitHub advisories and OSV data. These ignore
  // the limits above and any approval gate.
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["dependencies", "security"],
    prHourlyLimit: 0,
    prConcurrentLimit: 0,
    dependencyDashboardApproval: false,
  },
  osvVulnerabilityAlerts: true,

  customManagers: [
    {
      // The workflows install cyclonedx-gomod with `go install ...@vX`, which
      // no built-in manager reads. Renovate tracks those pins under the same
      // depName as the mise pin, so one group bumps both.
      description: "cyclonedx-gomod pinned by go install in the workflows",
      customType: "regex",
      fileMatch: ["^\\.github/workflows/[^/]+\\.ya?ml$"],
      matchStrings: [
        "go install github\\.com/CycloneDX/cyclonedx-gomod/cmd/cyclonedx-gomod@(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
      ],
      depNameTemplate: "github:CycloneDX/cyclonedx-gomod",
      packageNameTemplate: "CycloneDX/cyclonedx-gomod",
      datasourceTemplate: "github-releases",
    },
  ],

  packageRules: [
    {
      // scripts/tool-versions-check.sh fails unless mise.toml and the
      // goreleaser-action `version:` inputs of the workflows name the same
      // release, so both move in one PR.
      description: "Group goreleaser: mise.toml and the goreleaser-action steps",
      matchDepNames: ["goreleaser", "goreleaser/goreleaser"],
      groupName: "goreleaser",
    },
    {
      // Same check for cyclonedx-gomod: mise.toml and the go install lines of
      // the workflows must name the same tag.
      description: "Group cyclonedx-gomod: mise.toml and the workflow go install lines",
      matchDepNames: ["github:CycloneDX/cyclonedx-gomod"],
      groupName: "cyclonedx-gomod",
    },
    {
      // One PR for the Charm TUI stack: the modules are released together and
      // break when their versions drift apart.
      description: "Group the Charm modules",
      matchManagers: ["gomod"],
      matchPackageNames: ["charm.land/**", "github.com/charmbracelet/**"],
      groupName: "charm modules",
    },
    {
      // The go directive decides which Go toolchain CI and the release build
      // use (setup-go reads go.mod). "bump" moves it to every new Go release,
      // so security patches reach releases instead of waiting for a dependency.
      description: "Follow new Go releases in the go directive",
      matchManagers: ["gomod"],
      matchDepTypes: ["golang"],
      rangeStrategy: "bump",
    },
    {
      // mise.toml pins the same Go as go.mod; one PR bumps both files so they
      // never drift apart.
      description: "Group the Go toolchain: go.mod and mise.toml in one PR",
      matchManagers: ["mise", "gomod"],
      matchDepNames: ["go"],
      groupName: "go",
    },
    {
      // Major updates are breaking; they wait until someone ticks them in the
      // Dependency Dashboard issue.
      description: "Majors need approval in the dependency dashboard",
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
  ],
}
